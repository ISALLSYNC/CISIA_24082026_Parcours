{
  "uid": "indusense-slo",
  "title": "InduSense — SLO (M34)",
  "description": "Dashboard des 5 SLO de docs/slo.md (M33) : Service / Modèle / Données. Source : Prometheus par défaut.",
  "tags": ["indusense", "slo", "m34"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "row", "title": "Service", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat", "title": "SLO 1 — Disponibilité de l'API (objectif ≥ 99 %)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [ { "refId": "A", "expr": "avg_over_time(up{job=\"indusense-api\"}[30d])" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.99 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "SLO 2 — Latence p95 /predict-tabular (objectif < 1 s ; plafonnée à 1 s par les buckets)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/predict-tabular\"}[5m])) by (le))" } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2, "noValue": "pas de requête (SLI absent)",
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "SLO 3 — Taux de 5xx (objectif < 1 %)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [ { "refId": "A", "expr": "(sum(rate(http_requests_total{status=~\"5..\"}[30d])) or vector(0)) / sum(rate(http_requests_total[30d]))" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "Taux de 401 / s (sécurité — alerte d'exercice « pic de 401 »)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_requests_total{status=\"401\"}[1m])) or vector(0)", "legendFormat": "401 / s" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    { "type": "row", "title": "Modèle", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "panels": [] },
    {
      "type": "stat", "title": "Modèle chargé (indusense_model_loaded × scrape)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [ { "refId": "A", "expr": "(up{job=\"indusense-api\"} * on(job, instance) indusense_model_loaded{job=\"indusense-api\"}) or on(job, instance) (0 * up{job=\"indusense-api\"})" } ],
      "fieldConfig": { "defaults": { "decimals": 0,
        "mappings": [ { "type": "value", "options": { "0": { "text": "NON prêt" }, "1": { "text": "prêt" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "Prédictions servies / s, par décision",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 8 },
      "targets": [ { "refId": "A", "expr": "sum(rate(indusense_predictions_total[5m])) by (decision)", "legendFormat": "{{decision}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    { "type": "row", "title": "Données", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },
    {
      "type": "stat", "title": "SLO 4 — PSI température, janvier vs référence haute (objectif < 0,25)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 15 },
      "targets": [ { "refId": "A", "expr": "max(indusense_drift_psi{feature=\"temperature\", fenetre=\"janvier\", reference=\"haute\"})" } ],
      "fieldConfig": { "defaults": { "decimals": 3, "noValue": "exporteur absent (SLI absent)",
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.25 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "SLO 5 — Fraîcheur de la collecte drift (objectif ≥ 99 %)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 15 },
      "targets": [ { "refId": "A", "expr": "avg_over_time(up{job=\"indusense-drift\"}[30d])" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.99 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
